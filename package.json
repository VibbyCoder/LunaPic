{
  "name": "LunaPic",
  "version": "1.0.0",
  "description": "AMOLED Windows Image Viewer",
  "author": "Jay Yemekar",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
 "build": {
    "appId": "com.jay.lunapic",
    "productName": "LunaPic",
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3"
  }
}